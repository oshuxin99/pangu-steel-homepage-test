{
  "name": "pangu-steel-homepage-test",
  "version": "0.0.6",
  "description": "基于 Nuxt 3 和 Vue 3 的盘古钢铁首页模板",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/style.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "author": "oshuxin99",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oshuxin99/pangu-steel-homepage-test.git"
  },
  "homepage": "https://github.com/oshuxin99/pangu-steel-homepage-test#readme",
  "bugs": {
    "url": "https://github.com/oshuxin99/pangu-steel-homepage-test/issues"
  },
  "keywords": [
    "nuxt",
    "vue",
    "homepage",
    "template",
    "steel"
  ],
  "license": "UNLICENSED",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.20.2"
  },
  "packageManager": "pnpm@11.25.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm build:lib",
    "prepare:types": "nuxt prepare",
    "build:lib": "pnpm prepare:types && vite build --config vite.lib.config.ts",
    "build:preview": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "pack:check": "pnpm pack --dry-run",
    "test:package": "pnpm build:lib && node scripts/verify-package.mjs",
    "prepublishOnly": "pnpm test:package"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@element-plus/nuxt": "1.1.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "element-plus": "^2.14.7",
    "nuxt": "^3.21.11",
    "vite": "^7.3.7",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  }
}
